{
  "name": "guodu-prompt-engine-vscode",
  "displayName": "Guodu Prompt Engine",
  "description": "Markdown-based language support for Guodu prompt templates (.gdprompt) with custom tags, diagnostics, hovers, and completions.",
  "version": "0.1.1",
  "publisher": "guodu888",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": ["onLanguage:gdprompt"],
  "contributes": {
    "languages": [
      {
        "id": "gdprompt",
        "aliases": [
          "Guodu Prompt",
          "Guodu Prompt Template"
        ],
        "extensions": [
          ".gdprompt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gdprompt",
        "scopeName": "source.gdprompt",
        "path": "./syntaxes/guodu-template.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Guodu Prompt Engine",
      "properties": {
        "gdprompt.validateOnType": {
          "type": "boolean",
          "default": true,
          "description": "Validate .gdprompt files while typing."
        },
        "gdprompt.formatter.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable formatting support for .gdprompt files."
        },
        "gdprompt.formatter.normalizeIncludeQuotes": {
          "type": "boolean",
          "default": true,
          "description": "Normalize include paths to use double quotes."
        },
        "gdprompt.formatter.maxConsecutiveBlankLines": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "description": "Maximum blank lines kept between control-tag lines."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "bun run build && bunx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.0.0"
  }
}
